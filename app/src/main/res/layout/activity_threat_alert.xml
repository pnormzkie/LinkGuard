<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_gravity="center"
    android:layout_margin="22dp"
    android:background="@drawable/bg_e_alert"
    android:padding="28dp">

    <ImageView
        android:id="@+id/alertIcon"
        android:layout_width="72dp"
        android:layout_height="72dp"
        android:background="@drawable/bg_e_icon_badge_round"
        android:padding="16dp"
        android:src="@android:drawable/ic_dialog_alert"
        app:tint="@color/e_text"
        android:importantForAccessibility="no"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/alertTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="Threat Alert"
        android:textColor="@color/e_text"
        android:textSize="23sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/alertIcon" />

    <TextView
        android:id="@+id/alertMessage"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:gravity="center"
        android:lineSpacingMultiplier="1.45"
        android:text="Dangerous Link Detected! This could be a phishing attempt. Protect yourself."
        android:textColor="#F2FFFFFF"
        android:textSize="14sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/alertTitle" />

    <Button
        android:id="@+id/btnViewReport"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_marginTop="24dp"
        android:background="@drawable/bg_e_btn_white"
        android:text="@string/threat_alert_view_report"
        android:textColor="@color/e_red"
        android:textStyle="bold"
        android:stateListAnimator="@null"
        app:layout_constraintTop_toBottomOf="@id/alertMessage" />

    <Button
        android:id="@+id/btnDismiss"
        style="@style/Widget.MaterialComponents.Button.TextButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="@string/threat_alert_dismiss"
        android:textColor="@color/e_text"
        android:textSize="14sp"
        app:layout_constraintTop_toBottomOf="@id/btnViewReport" />

</androidx.constraintlayout.widget.ConstraintLayout>
