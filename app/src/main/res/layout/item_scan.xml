<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/card"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="10dp"
    app:cardBackgroundColor="@color/e_card"
    app:cardCornerRadius="16dp"
    app:cardElevation="4dp"
    app:rippleColor="#22FFFFFF">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="13dp">

        <View
            android:id="@+id/threatIndicator"
            android:layout_width="5dp"
            android:layout_height="46dp"
            android:background="@drawable/bg_e_bar"
            android:layout_marginEnd="12dp" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="5dp">

                <TextView
                    android:id="@+id/tvStatus"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="✓ SAFE"
                    android:textColor="@color/e_text"
                    android:textSize="10sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.03"
                    android:background="@drawable/bg_e_pill_solid"
                    android:paddingStart="9dp"
                    android:paddingEnd="9dp"
                    android:paddingTop="3dp"
                    android:paddingBottom="3dp"
                    android:layout_marginEnd="8dp" />

                <TextView
                    android:id="@+id/tvCategory"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Clean"
                    android:textColor="@color/e_muted"
                    android:textSize="11sp"
                    android:background="@drawable/bg_e_inner"
                    android:paddingStart="7dp"
                    android:paddingEnd="7dp"
                    android:paddingTop="2dp"
                    android:paddingBottom="2dp" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvUrl"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="https://example.com"
                android:textColor="@color/e_text2"
                android:textSize="12sp"
                android:fontFamily="monospace"
                android:maxLines="1"
                android:ellipsize="end"
                android:layout_marginBottom="4dp" />

            <TextView
                android:id="@+id/tvMeta"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="via Manual · Jun 01, 12:00"
                android:textColor="@color/e_muted"
                android:textSize="11sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvScore"
            android:layout_width="46dp"
            android:layout_height="46dp"
            android:text="0%"
            android:textSize="12sp"
            android:textStyle="bold"
            android:fontFamily="monospace"
            android:textColor="@color/e_text"
            android:gravity="center"
            android:background="@drawable/bg_e_score"
            android:layout_marginStart="12dp" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
