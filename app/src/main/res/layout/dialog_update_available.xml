<?xml version="1.0" encoding="utf-8"?>
<!--
  "Update available" hero card. Wrapped in a ScrollView so a long release-notes body can
  never push the Update button off-screen (lesson from the intercept block screen).
-->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:fillViewport="true"
    android:background="@android:color/transparent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="12dp"
        android:orientation="vertical"
        android:background="@drawable/bg_intercept_card"
        android:paddingHorizontal="24dp"
        android:paddingTop="28dp"
        android:paddingBottom="20dp">

        <FrameLayout
            android:layout_width="72dp"
            android:layout_height="72dp"
            android:layout_gravity="center_horizontal"
            android:background="@drawable/bg_e_icon_badge_blue">

            <ImageView
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_download"
                android:tint="@color/e_blue"
                android:contentDescription="@null" />
        </FrameLayout>

        <TextView
            android:id="@+id/tvUpdateTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:gravity="center"
            android:text="@string/update_available_title"
            android:textColor="@color/e_text"
            android:textSize="23sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvUpdateVersion"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:gravity="center"
            android:textColor="@color/e_blue"
            android:textSize="16sp"
            android:textStyle="bold"
            tools:text="Version 1.13" />

        <TextView
            android:id="@+id/tvUpdateCurrent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:gravity="center"
            android:textColor="@color/e_muted"
            android:textSize="13sp"
            tools:text="You're on 1.12" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="20dp"
            android:layout_marginBottom="16dp"
            android:background="@color/border" />

        <LinearLayout
            android:id="@+id/notesContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />

        <TextView
            android:id="@+id/btnUpdateNow"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:layout_marginTop="22dp"
            android:gravity="center"
            android:background="@drawable/bg_e_btn_blue"
            android:text="@string/update_now"
            android:textColor="@color/e_text"
            android:textSize="17sp"
            android:textStyle="bold"
            android:clickable="true"
            android:focusable="true" />

        <TextView
            android:id="@+id/tvUpdateLater"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:padding="12dp"
            android:gravity="center"
            android:text="@string/update_later"
            android:textColor="@color/e_muted"
            android:textSize="15sp"
            android:textStyle="bold"
            android:clickable="true"
            android:focusable="true"
            android:background="?attr/selectableItemBackground" />
    </LinearLayout>
</ScrollView>
