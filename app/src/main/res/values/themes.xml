<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="Theme.LinkGuard" parent="Theme.Material3.Dark">
        <!-- App background -->
        <item name="android:windowBackground">@color/bg_deep</item>
        <item name="android:colorBackground">@color/bg_deep</item>

        <!-- Primary = cyan accent -->
        <item name="colorPrimary">@color/cyan</item>
        <item name="colorOnPrimary">@color/bg_deep</item>
        <item name="colorPrimaryContainer">@color/surface</item>
        <item name="colorOnPrimaryContainer">@color/text_primary</item>

        <!-- Surface colors -->
        <item name="colorSurface">@color/surface</item>
        <item name="colorOnSurface">@color/text_primary</item>
        <item name="colorSurfaceVariant">@color/surface2</item>
        <item name="colorOnSurfaceVariant">@color/text_muted</item>

        <!-- Outline / border -->
        <item name="colorOutline">@color/border</item>

        <!-- Status bar -->
        <item name="android:statusBarColor">@color/bg_deep</item>
        <item name="android:navigationBarColor">@color/bg_deep</item>
        <item name="android:windowLightStatusBar">false</item>

        <!-- No action bar — we use custom header -->
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
    </style>

    <!-- Link-intercept verdict: full-screen translucent (NOT a floating dialog) so the
         centered card can scroll and never clips its decision buttons. The scrim comes from
         the layout's FrameLayout background. -->
    <style name="Theme.LinkGuard.Intercept" parent="Theme.LinkGuard">
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowContentOverlay">@null</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowAnimationStyle">@android:style/Animation.Dialog</item>
    </style>

    <!-- Splash / no-animation theme -->
    <style name="Theme.LinkGuard.NoActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
    </style>

</resources>
